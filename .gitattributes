# Shell scripts must keep LF endings — they run on Linux clusters/Colab, and a
# CRLF working copy on Windows otherwise commits \r bytes that break execution
# ($'\r' errors). Force LF for .sh regardless of core.autocrlf.
*.sh text eol=lf

# Extensionless entry-point scripts run on the cluster too — pin them to LF.
submit text eol=lf
run text eol=lf
resubmit text eol=lf
check-updates text eol=lf

# Vendored browser libraries ship verbatim and are inlined byte-for-byte into the
# run page. EOL conversion changes their length, corrupting the working copy on
# Windows and failing the vendoring check; never translate them.
biopipelines/renderers/vendor/** -text

# Python sources run on Linux clusters through generated bash; a CRLF blob in
# the index breaks a shebang and inflates every diff that touches the file.
*.py text eol=lf
