.DS_Store
._*
Thumbs.db

# PDB files (input/output structures, not committed)
*.pdb

# Structure and reflection files. *.pdb alone was not enough: run outputs are
# written as .cif, and crystallographic work adds reflection data. These are
# large, run-specific, and often unpublished — and the `public` branch of this
# GitLab repo is pushed to github.com/locbp-uzh/biopipelines automatically.
*.cif
*.mtz
*.mmcif

# Run outputs. Not ignored before, so `git add -A` would have swept in
# hundreds of run-specific structures.
results/

# Personal launchers and cluster job scripts. These name a specific campaign,
# username or billing account, so they are run-specific by nature even though
# they sit at the repository root. my_scripts/ and my_pipelines/ are already
# ignored for the same reason; these were simply outside both.
/submit_s3_chain.sh
jobs/

# Local agent-skill symlink (CLAUDE.md: skills/biopipelines is symlinked here
# so Claude Code discovers it). The target is tracked; the symlink is local.
.claude/skills/

